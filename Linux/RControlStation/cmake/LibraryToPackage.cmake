# LibraryToPackage.cmake
# Maps shared library names to Debian/Ubuntu package names
# This is used to automatically generate CPack dependencies

# Format: set(LIBRARY_NAME_PACKAGE "package-name")
# Where LIBRARY_NAME is the library without the 'lib' prefix and .so version

